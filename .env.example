# Copier ce fichier en .env et le compléter. Ne jamais versionner le vrai .env.

# Clé de signature des sessions du back-office (obligatoire).
# Générer avec : openssl rand -hex 32
PAYLOAD_SECRET=

# Base de données.
# - Local : SQLite (fichier créé au premier lancement).
# - Démonstration (Vercel) : Postgres Supabase, chaîne « Transaction pooler »
#   (Settings > Database > Connection string), ex.
#   postgresql://postgres.xxxx:MOTDEPASSE@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URI=file:./payload.db

# URL publique officielle du site (sans « / » final). Nom de domaine à décider.
# Sous toute autre adresse (*.vercel.app, *.cleverapps.io…), le site interdit son indexation.
NEXT_PUBLIC_SITE_URL=http://localhost:3092

# Stockage des fichiers envoyés depuis le BO (photos, PDF).
# Laisser vide en local : les fichiers vont dans ./media.
# Démonstration : Supabase Storage (Settings > Storage > S3 Connection).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# E-mails envoyés via Resend : formulaire de contact et e-mails du back-office
# (invitation d'un compte, mot de passe oublié). Sans clé, aucun e-mail ne part :
# en local, le message est écrit dans la console du serveur.
RESEND_API_KEY=
EMAIL_FROM="Alliance Française de Kumasi <noreply@example.com>"
# Destinataire des messages du formulaire de contact — adresse à fournir par l'Alliance.
CONTACT_EMAIL=

# Captcha Cloudflare Turnstile devant le back-office (/BO). Actif seulement si
# les deux clés sont renseignées ; le widget doit autoriser le domaine du site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
